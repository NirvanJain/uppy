{
  "name": "example-xhr-python",
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@uppy/core": "workspace:*",
    "@uppy/dashboard": "workspace:*",
    "@uppy/webcam": "workspace:*",
    "@uppy/xhr-upload": "workspace:*"
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.3",
    "vite": "^8.3.5"
  },
  "private": true,
  "scripts": {
    "installPythonDeps": "python3 -m pip install -r requirements.txt",
    "start": "node init && npm-run-all --parallel start:server start:client",
    "start:client": "node init && vite",
    "start:server": "node init && mkdir -p uploads && python3 server.py"
  }
}
