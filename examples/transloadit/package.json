{
  "name": "example-transloadit",
  "version": "0.0.0",
  "type": "module",
  "devDependencies": {
    "npm-run-all2": "^9.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@uppy/core": "workspace:*",
    "@uppy/dashboard": "workspace:*",
    "@uppy/form": "workspace:*",
    "@uppy/image-editor": "workspace:*",
    "@uppy/remote-sources": "workspace:*",
